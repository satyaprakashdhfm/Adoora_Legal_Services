// ADOORA Legal Services — API data model.
//
// Scope note: this covers the public website (intake, applications,
// subscriptions), staff and client accounts, and the case and document
// records behind the client dashboard and the admin console. RAG/chatbot
// models are deliberately not created yet — see docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7+).
}

// ---------------------------------------------------------------------------
// Staff accounts and audit
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER // full access, can manage other users
  ADMIN // manage cases, documents, clients, enquiries, applications, content
  LAWYER // the cases they are assigned to
  EDITOR // content only
}

/// A member of the firm. Clients are not users — see `Client`. Keeping the
/// two apart means a bug in one audience's checks cannot hand the other
/// audience's access to a client.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  /// Null for accounts that only ever sign in with Google.
  passwordHash String?
  /// Google's stable subject id, linked on first Google sign-in.
  googleSub    String?   @unique
  avatarUrl    String?
  phone        String?
  /// Bar Council enrolment number, for advocates.
  barEnrolment String?
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles    Article[]
  auditLogs   AuditLog[]
  sessions    Session[]
  assignments CaseAssignment[]

  casesCreated    Case[]            @relation("CaseCreatedByUser")
  updatesAuthored CaseUpdate[]      @relation("UpdateAuthorUser")
  documentsAdded  Document[]        @relation("DocumentUploadedByUser")
  versionsAdded   DocumentVersion[] @relation("VersionUploadedByUser")
  queriesAnswered ClientQuery[]     @relation("QueryAnsweredBy")
  /// The lawyer's public profile on the website, when they have one.
  profile         LawyerProfile?
  courtLookups    CourtSnapshot[]   @relation("SnapshotFetchedByUser")

  @@index([email])
}

/// Append-only record of who did what. Enquiries and case documents can
/// contain privileged information, so who read or changed what needs to be
/// reconstructable — document downloads are logged here, not only uploads.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Set instead of actorId when a client did it.
  actorClientId String?  @db.Uuid
  actorClient   Client?  @relation(fields: [actorClientId], references: [id], onDelete: SetNull)
  action        String // e.g. "enquiry.status_changed"
  entityType    String // e.g. "Enquiry"
  entityId      String?
  /// Before/after values, or request context for unauthenticated actions.
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([actorClientId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Client accounts and sessions
// ---------------------------------------------------------------------------

enum ClientKind {
  INDIVIDUAL
  ORGANISATION
}

/// A person or organisation the firm acts for, who signs in to the client
/// dashboard. Created on first Google sign-in, or in advance by an admin so
/// the account is waiting when the client arrives.
model Client {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  kind         ClientKind @default(INDIVIDUAL)
  /// Organisation name when the client acts for a company.
  organisation String?
  phone        String?
  address      String?    @db.Text
  googleSub    String?    @unique
  avatarUrl    String?
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions        Session[]
  cases           CaseClient[]
  auditLogs       AuditLog[]
  casesCreated    Case[]            @relation("CaseCreatedByClient")
  updatesAuthored CaseUpdate[]      @relation("UpdateAuthorClient")
  documentsAdded  Document[]        @relation("DocumentUploadedByClient")
  versionsAdded   DocumentVersion[] @relation("VersionUploadedByClient")
  queries         ClientQuery[]
  courtLookups    CourtSnapshot[]   @relation("SnapshotFetchedByClient")

  @@index([createdAt])
}

/// Server-side session behind the httpOnly cookie. Only a hash of the token
/// is stored, so reading the table does not yield usable sessions. Unlike a
/// stateless token, a row can be revoked the moment an account is disabled.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?   @db.Uuid
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// "google" or "password".
  method     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Cases (matters)
// ---------------------------------------------------------------------------

enum CaseStatus {
  INTAKE // opened by a client or the firm, not yet taken on
  ACTIVE
  ON_HOLD
  DISPOSED // decided by the court or forum
  CLOSED // file closed by the firm
  WITHDRAWN
}

/// Procedural stage, in the terms Indian courts use on their case status pages.
enum CaseStage {
  PRE_FILING
  FILED
  UNDER_SCRUTINY
  DEFECTS_NOTIFIED
  REGISTERED
  ADMISSION
  NOTICE_ISSUED
  PLEADINGS
  EVIDENCE
  ARGUMENTS
  RESERVED_FOR_ORDERS
  DISPOSED
}

enum CourtLevel {
  SUPREME_COURT
  HIGH_COURT
  DISTRICT_COURT
  SUBORDINATE_COURT // civil judge, magistrate
  FAMILY_COURT
  COMMERCIAL_COURT
  TRIBUNAL // NCLT, NCLAT, ITAT, DRT, NGT, CAT, ...
  CONSUMER_COMMISSION
  ARBITRATION
  QUASI_JUDICIAL // regulators and statutory authorities
  NOT_IN_LITIGATION // advisory or transactional matters
  OTHER
}

/// A matter. The reference (`ALS-2026-K7Q3X9`) is the firm's own file number
/// and never changes; the court's case number is recorded separately because
/// it only exists once the court registers the case, and can change on
/// transfer.
model Case {
  id           String     @id @default(uuid()) @db.Uuid
  reference    String     @unique
  title        String
  summary      String?    @db.Text
  /// Practice-area slug from the website's practice-areas.ts.
  practiceArea String?
  status       CaseStatus @default(INTAKE)
  stage        CaseStage  @default(PRE_FILING)

  // Forum.
  courtLevel CourtLevel @default(NOT_IN_LITIGATION)
  /// e.g. "High Court for the State of Telangana".
  courtName  String?
  /// Principal seat or named bench, e.g. "Principal Seat at Hyderabad".
  bench      String?
  state      String?
  district   String?
  courtHall  String?
  /// Judge(s) the matter is listed before.
  coram      String?

  // Court numbering. Case type codes vary by court (WP, WA, CRL.P, CRP, AS,
  // OS, SLP(C), ...), so they are stored as the court writes them.
  caseTypeCode     String?
  caseTypeName     String?
  caseNumber       String?
  caseYear         Int?
  /// Filing or diary number, assigned before registration.
  filingNumber     String?
  filingDate       DateTime? @db.Date
  registrationDate DateTime? @db.Date
  /// eCourts Case Number Record — 16 characters, e.g. HBHC01… for the Telangana High Court.
  cnrNumber        String?

  /// Provisions invoked, e.g. "Article 226, Constitution of India".
  actsAndSections String[] @default([])
  reliefSought    String?  @db.Text

  // Lower forum, for appeals, revisions and writs against an order.
  originCourt       String?
  originCaseNumber  String?
  impugnedOrderDate DateTime? @db.Date

  // Hearing calendar.
  lastHearingDate    DateTime? @db.Date
  nextHearingDate    DateTime? @db.Date
  nextHearingPurpose String?
  disposalDate       DateTime? @db.Date
  disposalNature     String?

  // What the court's own record says, from the last eCourts sync. Kept as
  // the court words them: the court's status and stage vocabularies vary by
  // court and do not map one-to-one onto `status` and `stage`, which are the
  // firm's own view of the matter.
  courtStatus    String?
  courtStage     String?
  /// Last successful eCourts check, whether or not anything had changed.
  courtCheckedAt DateTime?

  /// Counter behind the document references, so they run D001, D002, ...
  /// within a case without revealing the firm's overall volume.
  documentSeq Int @default(0)

  createdById       String? @db.Uuid
  createdBy         User?   @relation("CaseCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  createdByClientId String? @db.Uuid
  createdByClient   Client? @relation("CaseCreatedByClient", fields: [createdByClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties     CaseParty[]
  clients     CaseClient[]
  assignments CaseAssignment[]
  updates     CaseUpdate[]
  documents   Document[]
  hearings    CourtHearing[]
  orders      CourtOrder[]
  snapshots   CourtSnapshot[]
  queries     ClientQuery[]

  @@index([status, updatedAt])
  @@index([courtLevel])
  @@index([nextHearingDate])
  @@index([cnrNumber])
}

enum PartyRole {
  PETITIONER
  RESPONDENT
  APPELLANT
  APPLICANT
  PLAINTIFF
  DEFENDANT
  COMPLAINANT
  ACCUSED
  OPPOSITE_PARTY
  INTERVENOR
  OTHER
}

/// A party as the cause title names it — "Respondent No. 2" is role
/// RESPONDENT, position 2.
model CaseParty {
  id       String    @id @default(uuid()) @db.Uuid
  caseId   String    @db.Uuid
  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role     PartyRole
  position Int       @default(1)
  name     String
  /// True for the party (or parties) the firm represents.
  isClient Boolean   @default(false)
  /// Advocate for this party, where known.
  counsel  String?

  @@index([caseId])
}

/// Which client accounts can see a case.
model CaseClient {
  caseId   String   @db.Uuid
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId String   @db.Uuid
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@id([caseId, clientId])
  @@index([clientId])
}

enum AssignmentRole {
  LEAD
  ASSOCIATE
  SUPPORT
}

/// Which lawyers work a case. A LAWYER sees only the cases assigned here.
model CaseAssignment {
  caseId     String         @db.Uuid
  case       Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AssignmentRole @default(ASSOCIATE)
  assignedAt DateTime       @default(now())

  @@id([caseId, userId])
  @@index([userId])
}

enum UpdateKind {
  NOTE
  HEARING
  ORDER
  FILING
  STATUS_CHANGE
  DOCUMENT
}

enum Visibility {
  CLIENT // the client can see it
  INTERNAL // firm only
}

/// The case timeline both dashboards read — hearings, orders, notes, and the
/// entries written automatically for uploads and status changes.
model CaseUpdate {
  id         String     @id @default(uuid()) @db.Uuid
  caseId     String     @db.Uuid
  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       UpdateKind @default(NOTE)
  title      String
  body       String?    @db.Text
  /// When the event happened (a hearing date), as opposed to when it was logged.
  eventDate  DateTime?  @db.Date
  visibility Visibility @default(CLIENT)

  authorUserId   String? @db.Uuid
  authorUser     User?   @relation("UpdateAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorClientId String? @db.Uuid
  authorClient   Client? @relation("UpdateAuthorClient", fields: [authorClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Court record (eCourts)
// ---------------------------------------------------------------------------

/// One eCourtsIndia response, stored exactly as received. A new row is
/// written only when the record has changed since the last one for that CNR
/// (compared by `contentHash`); an unchanged check just moves
/// `Case.courtCheckedAt`. That keeps a history of what the court's record
/// said and when, without a row for every look.
///
/// `caseId` is null for a lookup made before the case was opened (the
/// "fill from CNR" step); it is attached when a case with that CNR is saved.
model CourtSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  cnr         String
  caseId      String?  @db.Uuid
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  source      String   @default("ecourtsindia")
  /// eCourtsIndia's request id — quote it to their support.
  requestId   String?
  /// SHA-256 of the payload with volatile timestamps removed.
  contentHash String
  payload     Json
  fetchedAt   DateTime @default(now())

  fetchedByUserId   String? @db.Uuid
  fetchedByUser     User?   @relation("SnapshotFetchedByUser", fields: [fetchedByUserId], references: [id], onDelete: SetNull)
  fetchedByClientId String? @db.Uuid
  fetchedByClient   Client? @relation("SnapshotFetchedByClient", fields: [fetchedByClientId], references: [id], onDelete: SetNull)

  @@index([cnr, fetchedAt])
  @@index([caseId, fetchedAt])
}

/// A hearing from the court's case history — the "business on date" table
/// on an eCourts status page. Upserted on every sync by (case, date), so
/// re-reading the same history never duplicates it.
model CourtHearing {
  id          String    @id @default(uuid()) @db.Uuid
  caseId      String    @db.Uuid
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hearingDate DateTime  @db.Date
  /// e.g. "Admission", "Hearing", "Arguments", "Orders".
  purpose     String?
  judge       String?
  /// What was recorded as done on the day, where the court gives it.
  business    String?   @db.Text
  nextDate    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([caseId, hearingDate])
}

/// An interim order or judgment listed on the court's record.
model CourtOrder {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderDate DateTime @db.Date
  /// e.g. "Interim Order", "Final Order", "Judgment".
  orderType String   @default("Order")
  /// The file name eCourtsIndia gives for the order PDF.
  fileName  String   @default("")
  /// Short summary, where eCourtsIndia provides one.
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([caseId, orderDate, orderType, fileName])
}

// ---------------------------------------------------------------------------
// Client queries
// ---------------------------------------------------------------------------

enum QueryStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A question a signed-in client raises from their dashboard, optionally
/// about one of their cases. Distinct from `Enquiry`, which is a stranger
/// writing in through the public website's contact form.
model ClientQuery {
  id        String      @id @default(uuid()) @db.Uuid
  reference String      @unique // e.g. QRY-2A4F19
  clientId  String      @db.Uuid
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  caseId    String?     @db.Uuid
  case      Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  subject   String
  message   String      @db.Text
  status    QueryStatus @default(OPEN)

  reply        String?   @db.Text
  answeredById String?   @db.Uuid
  answeredBy   User?     @relation("QueryAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentCategory {
  PETITION // plaints, petitions, applications
  PLEADING // written statements, counters, replies, rejoinders
  AFFIDAVIT
  VAKALATNAMA
  EVIDENCE
  ORDER
  JUDGMENT
  NOTICE
  CORRESPONDENCE
  AGREEMENT
  IDENTITY // KYC and identity proofs
  FINANCIAL
  OTHER
}

/// A document on a case, or — with no case — in the firm's "Team shared"
/// folder (templates, precedents, forms), which only staff can see. The
/// bytes live in object storage, one object per version, so nothing is ever
/// overwritten in place.
model Document {
  id             String           @id @default(uuid()) @db.Uuid
  /// `ALS-2026-K7Q3X9-D004` — the case reference plus a per-case sequence;
  /// `ALS-TEAM-K7Q3X9` for a team document.
  reference      String           @unique
  caseId         String?          @db.Uuid
  case           Case?            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  seq            Int
  title          String
  category       DocumentCategory @default(OTHER)
  description    String?          @db.Text
  visibility     Visibility       @default(CLIENT)
  currentVersion Int              @default(1)

  uploadedByUserId   String? @db.Uuid
  uploadedByUser     User?   @relation("DocumentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByClientId String? @db.Uuid
  uploadedByClient   Client? @relation("DocumentUploadedByClient", fields: [uploadedByClientId], references: [id], onDelete: SetNull)

  /// Soft delete. The stored objects are kept: record-keeping obligations,
  /// not a button, decide when they may be destroyed.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions DocumentVersion[]

  @@unique([caseId, seq])
  @@index([caseId, deletedAt])
  @@index([createdAt])
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @db.Uuid
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  /// Object key in the storage provider. Carries no filename or client
  /// detail, so a bucket listing reveals nothing.
  storageKey    String   @unique
  /// Which storage driver holds the object ("s3", "local").
  storageDriver String
  filename      String
  mimeType      String
  sizeBytes     Int
  /// SHA-256 of the plaintext, for integrity checks.
  sha256        String

  // Envelope encryption: the object is AES-256-GCM encrypted under a random
  // data key, and the data key is stored here wrapped by the master key
  // named in encKeyId.
  encKeyId   String
  wrappedKey String
  iv         String
  authTag    String

  uploadedByUserId   String? @db.Uuid
  uploadedByUser     User?   @relation("VersionUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByClientId String? @db.Uuid
  uploadedByClient   Client? @relation("VersionUploadedByClient", fields: [uploadedByClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([documentId, version])
}

// ---------------------------------------------------------------------------
// Website: lawyer profiles and job openings
// ---------------------------------------------------------------------------

enum ProfileGroup {
  LEGAL // leadership and advocates
  BUSINESS // business advisory
}

/// A person as the website shows them — the home page's "Our people" and
/// the About page roster. Managed from the console, because the team
/// changes. `userId` links the profile to that lawyer's sign-in account, so
/// the same person is one person across the website, the cases and the
/// client dashboard.
model LawyerProfile {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  name          String
  designation   String
  group         ProfileGroup @default(LEGAL)
  qualification String?
  office        String?
  enrolment     String?
  stateBar      String?
  enrolledSince Int?
  experience    String?
  /// Practice-area slugs from the website's practice-areas.ts.
  practices     String[]     @default([])
  education     String[]     @default([])
  /// Paragraphs. A bio is what earns a long-form profile on the About page.
  bio           String[]     @default([])
  memberships   String[]     @default([])
  email         String?
  /// Home page introduction.
  summary       String?      @db.Text

  /// Base name of a portrait bundled with the website (`public/`), for the
  /// profiles carried over from the static roster.
  photo          String?
  /// An uploaded portrait, stored inline: a few hundred KB at most.
  photoData      Bytes?
  photoType      String?
  photoUpdatedAt DateTime?

  /// Shown on the home page.
  featured  Boolean @default(false)
  /// Hidden from the website when false; kept for the record.
  published Boolean @default(true)
  sortOrder Int     @default(0)

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

enum JobStatus {
  DRAFT // being written, not on the website
  OPEN // listed on /careers and accepting applications
  CLOSED // no longer listed
}

/// A vacancy on the careers page, posted from the console.
model JobOpening {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  title            String
  /// Practice-area slug, where the role sits in one.
  practiceArea     String?
  location         String?
  /// e.g. "Full-time", "Internship".
  employmentType   String    @default("Full-time")
  /// e.g. "2–4 years' post-qualification".
  experience       String?
  summary          String    @db.Text
  responsibilities String[]  @default([])
  requirements     String[]  @default([])
  status           JobStatus @default(DRAFT)
  closesOn         DateTime? @db.Date
  publishedAt      DateTime?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, sortOrder])
}

// ---------------------------------------------------------------------------
// Client intake
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  ACKNOWLEDGED
  CONFLICT_CHECK
  ENGAGED
  DECLINED
  CLOSED
}

/// A website enquiry. Not a client record: an enquiry becomes a client only
/// after the conflicts check clears and an engagement is confirmed in writing.
model Enquiry {
  id          String        @id @default(uuid()) @db.Uuid
  reference   String        @unique // human-quotable, e.g. ENQ-2A4F19
  name        String
  email       String
  phone       String
  matterType  String
  description String        @db.Text
  status      EnquiryStatus @default(NEW)

  /// Explicit DPDP consent, plus when it was given. Both are required for
  /// submission and are retained as evidence of the consent.
  consent   Boolean
  consentAt DateTime

  /// Request context, kept for abuse investigation and deleted with the record.
  ipAddress String?
  userAgent String?

  /// Internal handling. Never exposed on a public endpoint.
  assignedTo     String?
  internalNote   String?   @db.Text
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

model CareerApplication {
  id         String            @id @default(uuid()) @db.Uuid
  reference  String            @unique // e.g. APP-7C1B03
  name       String
  email      String
  phone      String
  role       String
  experience String
  /// Bar Council enrolment number, where the applicant is enrolled.
  enrolment  String?
  message    String            @db.Text
  status     ApplicationStatus @default(NEW)

  consent   Boolean
  consentAt DateTime

  ipAddress String?
  userAgent String?

  internalNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

model Subscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String?
  /// Double opt-in: a subscriber is only mailed once confirmedAt is set.
  confirmToken   String?   @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// Practice-area slugs the subscriber asked to hear about. Empty means all.
  interests      String[]  @default([])

  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([confirmedAt])
}

// ---------------------------------------------------------------------------
// Content (CMS for Insights)
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Mirrors the shape of `apps/web/src/content/insights.ts` so the site can be
/// switched from file-based content to the database without a page rewrite.
model Article {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  category     String
  summary      String   @db.Text
  /// Block array — see the `Block` type in the web app.
  body         Json
  keyTakeaways String[] @default([])
  readingTime  String?
  /// Practice-area and industry slugs, used for cross-linking.
  practices    String[] @default([])
  industries   String[] @default([])

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  authorId   String? @db.Uuid
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Person slug from the web app's people.ts, for the by-line, where the
  /// author is not a portal user.
  authorSlug String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}
