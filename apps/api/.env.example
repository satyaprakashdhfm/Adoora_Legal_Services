# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
# Local:   postgresql://postgres:postgres@localhost:5432/adoora
# Railway: reference the Postgres service with ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adoora"

# Origins allowed to call this API, comma separated. The web app's URL must
# be listed here or browsers will block the contact form.
CORS_ORIGINS="http://localhost:3000"

# Signing secret for admin session tokens. Required in production, 32+ chars.
# Generate with: openssl rand -base64 48
JWT_SECRET=""

# Where enquiry notifications are sent, once mail delivery is configured.
NOTIFY_EMAIL=""

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Client & admin portal -------------------------------------------------

# Public URL of the WEBSITE (not this API). The browser reaches the API through
# the website's /api rewrite, so session cookies and the Google redirect URI
# belong to this origin.
APP_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorised redirect URI must be exactly: ${APP_URL}/api/auth/google/callback
# Google sign-in stays switched off until both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails that become OWNER staff accounts on their first Google sign-in.
# Comma separated. Bootstraps the first administrator without a password.
ADMIN_EMAILS=""

# Whether an unknown Google account may create a client account on sign-in.
ALLOW_CLIENT_SIGNUP="true"

# Document storage. "local" (development only) or "s3" (any S3-compatible
# store — Railway Buckets, AWS S3, Cloudflare R2, MinIO). Production requires s3.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# On Railway, set these as references to the bucket's variables, e.g.
#   S3_BUCKET=${{documents.BUCKET}}  S3_ENDPOINT=${{documents.ENDPOINT}} ...
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Master key for document encryption: 32 bytes, base64. Required in production.
# Generate with: openssl rand -base64 32   — and never lose it: without it,
# stored documents cannot be decrypted.
DOCUMENT_ENCRYPTION_KEY=""
DOCUMENT_ENCRYPTION_KEY_ID="k1"

MAX_UPLOAD_MB=25
