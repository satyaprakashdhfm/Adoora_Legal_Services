# Copy to .env.local for development. Never commit .env.local.

# Canonical public origin. Used for metadataBase, sitemap.xml and JSON-LD, so
# it must be the real public URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base URL of the Express API. Leave empty to call the same origin (only
# correct if something is proxying /api to the API service).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Where this server forwards /api/* (the dashboards and Google sign-in go
# through it, so cookies stay first-party). On Railway use the API's private
# address, e.g. http://adoora-api.railway.internal:8080. Read at build time.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:4000.
API_INTERNAL_URL="http://localhost:4000"
