# Copy to .env.local for development. Never commit .env.local.

# Canonical public origin. Used for metadataBase, sitemap.xml and JSON-LD, so
# it must be the real public URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base URL of the Express API. Leave empty to call the same origin (only
# correct if something is proxying /api to the API service).
NEXT_PUBLIC_API_URL="http://localhost:4000"
